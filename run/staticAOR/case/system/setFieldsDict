FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    alpha.metal 0;
};

zones
{
    powderBed
    {
        type        spheres;
        data
        (
            #include "filteredSpherePack"
        );
        scale       1.0;
        values
        {
            alpha.metal     1;
        }
    }

};

